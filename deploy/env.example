# 复制为 /opt/bbs-go/.env 后修改。
# 必须在首次 `docker compose up -d` 之前设置；数据库卷初始化后再改密码会导致应用连不上库。
BBSGO_DOCKER_POSTGRESQL_DATABASE=bbsgo
BBSGO_DOCKER_POSTGRESQL_USER=bbsgo
BBSGO_DOCKER_POSTGRESQL_PASSWORD=请替换为强密码

# 镜像 tag 不在此文件配置：日常用脚本默认的 latest；
# 回滚时通过命令行覆盖，例如：
#   BBSGO_IMAGE=ghcr.io/creeper-scr/bbs-vivalavita:sha-<commit> bash deploy/remote-deploy.sh
